# A Fusee server under systemd.
#
#   sudo useradd --system --home /var/lib/fusee fusee
#   sudo install -m 0755 fusee /usr/local/bin/fusee
#   sudo install -m 0600 -o fusee token /etc/fusee/token     # openssl rand -hex 32
#   sudo cp fusee.service /etc/systemd/system/ && sudo systemctl enable --now fusee
#
# Workers and clients connect to :7600 with the token; the HTTP API, the UI
# and /metrics are on :7601 (Bearer token off loopback). The data directory
# needs a disk that honours flushes (fusee doctor /var/lib/fusee).
[Unit]
Description=Fusee durable execution server
After=network-online.target
Wants=network-online.target

[Service]
User=fusee
Group=fusee
StateDirectory=fusee
ExecStart=/usr/local/bin/fusee server --dir /var/lib/fusee --listen 0.0.0.0:7600 \
    --http 0.0.0.0:7601 --token-file /etc/fusee/token
# SIGTERM: the server flushes and stops; runs resume on the next start.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=1
LimitNOFILE=65536
# Hardening: the server needs its directory and the network, nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fusee
ReadOnlyPaths=/etc/fusee

[Install]
WantedBy=multi-user.target
