FROM rust:1.95-trixie
RUN apt-get update && apt-get install -y --no-install-recommends cmake fuse3 libfuse3-dev iproute2 iptables libfaketime dmsetup e2fsprogs && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 0.3.1 https://github.com/dsrhaslab/lazyfs.git /opt/lazyfs && test "$(git -C /opt/lazyfs rev-parse HEAD)" = 045a0b3a1126725e693934e29d3ba15e08cc39ec
WORKDIR /opt/lazyfs
RUN cmake -S libs/libpcache -B libs/libpcache/build && cmake --build libs/libpcache/build -j4 && cmake -S lazyfs -B lazyfs/build -DLAZYFS_BUILD_TESTS=OFF && cmake --build lazyfs/build -j4
WORKDIR /src
