package obelisk:workflow@7.0.0;
interface workflow-support {
    use obelisk:types/time@6.0.0.{schedule-at, datetime};
    sleep: func(schedule-at: schedule-at, name: option<string>) -> result<datetime>;
    use obelisk:types/join-set@6.0.0.{join-set};
    variant join-next-error { all-processed }
    join-set-create: func() -> join-set;
    join-next: func(join-set: borrow<join-set>) -> result<result<option<string>, option<string>>, join-next-error>;
}
interface workflow-dynamic-support {
    use obelisk:types/function@6.0.0.{function};
    use obelisk:types/execution@6.0.0.{execution-id};
    use obelisk:types/join-set@6.0.0.{join-set};
    variant submit-json-error { ffqn-parsing-error(string), function-not-found, type-check-error(string), value-too-large(u64) }
    submit-json: func(join-set: borrow<join-set>, function: function, params: string) -> result<execution-id, submit-json-error>;
}
